+[Unit]
+Description=Simulador de maquinas ArquiFusion (Flujo 1)
+After=network-online.target
+Wants=network-online.target
+
+[Service]
+User=ec2-user
+WorkingDirectory=/home/ec2-user/arquifusion-flujo1
+EnvironmentFile=/etc/simulador.env
+ExecStart=/usr/bin/python3 /home/ec2-user/arquifusion-flujo1/simulador.py
+Restart=always
+RestartSec=10
+
+[Install]
+WantedBy=multi-user.target
